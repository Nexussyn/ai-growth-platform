# =============================================================================
# AI GROWTH — fichier d'exemple de configuration
# Copier ce fichier vers .env et renseigner les vraies valeurs.
# NE JAMAIS committer .env ni aucune valeur réelle de secret dans git.
# =============================================================================

# -----------------------------------------------------------------------------
# Edge Function Secrets
# À configurer dans Supabase -> Settings -> Edge Functions -> Secrets.
# -----------------------------------------------------------------------------

# OBLIGATOIRE pour l'intelligence réelle (qualification/exécution des jobs).
# Clé API Claude (Anthropic), format sk-ant-...
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Injectés AUTOMATIQUEMENT par Supabase dans le runtime des Edge Functions.
# Inutile de les renseigner pour un déploiement Supabase standard ; listés ici
# pour documentation et pour l'exécution locale (supabase functions serve).
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optionnel : connexion Postgres directe utilisée par certaines fonctions
# (ex. runtime-discovery via postgres.js). Injecté par Supabase en production.
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Notifications Telegram (OPTIONNEL)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

# -----------------------------------------------------------------------------
# Front statique (build Vite, OPTIONNEL)
# Variables exposées au client : utiliser UNIQUEMENT la clé anon (publique),
# JAMAIS la service_role.
# -----------------------------------------------------------------------------
# VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# VITE_SUPABASE_ANON_KEY=your_public_anon_key_here
